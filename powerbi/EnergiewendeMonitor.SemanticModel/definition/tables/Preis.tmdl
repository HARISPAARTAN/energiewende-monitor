/// Hourly day-ahead price per region (SMARD), keyed to the first quarter-hour of the hour.
table Preis
	lineageTag: c969355d-70d9-58b7-8a25-1c35decb63be

	column 'Region Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: d241c842-dfe9-57a6-a4b1-7a6838e67f94
		summarizeBy: none
		sourceColumn: region_key

		annotation SummarizationSetBy = User

	column 'Zeitstempel UTC'
		dataType: dateTime
		isHidden
		formatString: General Date
		lineageTag: 596fdc7d-6cc3-59d8-8d24-46efc66fe52e
		summarizeBy: none
		sourceColumn: ts_utc

		annotation SummarizationSetBy = Automatic

	column 'Datum Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5cdf92e8-690c-57d1-81b8-ba443072f596
		summarizeBy: none
		sourceColumn: datum_key

		annotation SummarizationSetBy = User

	column 'Zeit Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 4a170890-bb87-5c63-bb54-b5e4b593932a
		summarizeBy: none
		sourceColumn: zeit_key

		annotation SummarizationSetBy = User

	column 'Day-Ahead €/MWh'
		dataType: double
		isHidden
		lineageTag: 198784df-0eff-5ca9-9e1a-ed2ab81e506f
		summarizeBy: none
		sourceColumn: day_ahead_eur_mwh

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Day-ahead price rounded down to a 10 EUR/MWh bin, for the price histogram.
	column 'Preis Klasse (10 €)' = IF(ISBLANK(Preis[Day-Ahead €/MWh]), BLANK(), INT(Preis[Day-Ahead €/MWh] / 10) * 10)
		dataType: int64
		formatString: #,0 "€"
		lineageTag: 061bc869-f1bb-55a8-ba23-1d95ff345b5a
		summarizeBy: none
		sortByColumn: 'Preis Klasse Sortierung'

		annotation SummarizationSetBy = User

	/// Numeric sort key of the price bin.
	column 'Preis Klasse Sortierung' = IF(ISBLANK(Preis[Day-Ahead €/MWh]), BLANK(), INT(Preis[Day-Ahead €/MWh] / 10) * 10)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 56863319-d4f5-5aab-ac2d-05b8b9f940fa
		summarizeBy: none

		annotation SummarizationSetBy = User

	partition Preis = m
		mode: import
		source =
				let
				    Quelle = Sql.Database("127.0.0.1,1433", "energiewende"),
				    rpt_v_preis = Quelle{[Schema="rpt",Item="v_preis"]}[Data]
				in
				    rpt_v_preis

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

